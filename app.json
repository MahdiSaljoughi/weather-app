{
  "expo": {
    "name": "WeatherApp",
    "slug": "WeatherApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-m.png",
    "scheme": "weatherapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/icon-m.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mahdisaljoughi.weatherapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon-m.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "09812e12-c599-4577-b797-d5005992373a"
      }
    }
  }
}
